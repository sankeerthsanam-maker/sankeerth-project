{
  "name": "sankee-audio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "prebuild": "node --experimental-strip-types scripts/export-catalogue.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "typescript": "^7.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
